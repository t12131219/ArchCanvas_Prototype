        "title": "Linear",
        "source": "import torch\nfrom torch import nn\n\nclass Linear(nn.Module):\n    def __init__(self, in_features=64, out_features=64, bias=True):\n        super().__init__()\n        self.proj = nn.Linear(in_features, out_features, bias=bias)\n    def forward(self, x):\n        return self.proj(x)\n",
