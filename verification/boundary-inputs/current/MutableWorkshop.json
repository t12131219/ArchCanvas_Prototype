    {
      "id": "model/43:4:composite:1/35:4:composite:1",
      "kind": "composite",
      "label": "self.weave",
      "parent": "model/43:4:composite:1",
      "source_parent": "model/43:4:composite:1",
      "source": [
        {
          "file": "/home/fzg/PycharmProjects/ArchCanvas/prototype/Summary_Merge/tests/semantic_fixtures/boundary_inputs.py",
          "line": 35,
          "end_line": 41,
          "column": 4,
          "end_column": 48,
          "symbol": "weave",
          "expression": "def weave(self, signal, context):\n    a = torch.sin(torch.cos(torch.relu(signal)))\n    b = torch.cos(torch.tanh(torch.sin(signal)))\n    c = torch.relu(torch.sin(torch.cos(signal)))\n    f = torch.cat((a, b, c), dim=-1)\n    context.add_(f)\n    return torch.tanh(f * context) + context"
        }
      ],
      "evidence_status": "static-only",
      "granularity": "composite",
