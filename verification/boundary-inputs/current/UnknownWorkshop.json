      "id": "model/30:4:composite:1/22:4:composite:1",
      "kind": "composite",
      "label": "self.weave",
      "parent": "model/30:4:composite:1",
      "source_parent": "model/30:4:composite:1",
      "source": [
        {
          "file": "/home/fzg/PycharmProjects/ArchCanvas/prototype/Summary_Merge/tests/semantic_fixtures/boundary_inputs.py",
          "line": 22,
          "end_line": 28,
          "column": 4,
          "end_column": 38,
          "symbol": "weave",
          "expression": "def weave(self, signal, context):\n    a = torch.sin(torch.cos(torch.relu(signal)))\n    b = torch.cos(torch.tanh(torch.sin(signal)))\n    c = torch.relu(torch.sin(torch.cos(signal)))\n    f = torch.cat((a, b, c), dim=-1)\n    g = external_unresolved(f, context)\n    return torch.tanh(g) + context"
        }
      ],
