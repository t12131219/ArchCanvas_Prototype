          "end_line": 34,
          "column": 4,
          "end_column": 22,
          "symbol": "EscapingDecision.forward",
          "expression": "def forward(self, x, gate=None):\n    a = x.sin()\n    b = a.cos()\n    c = b.tanh()\n    d = c.relu()\n    test = gate is not None\n    if test:\n        d = d * gate\n    e = d.sin()\n    f = e.cos()\n    g = f.tanh()\n    h = g.relu()\n    return (h, test)"
        }
      ],
