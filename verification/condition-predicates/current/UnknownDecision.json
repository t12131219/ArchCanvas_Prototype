          "end_column": 23,
          "symbol": "UnknownDecision.forward",
          "expression": "def forward(self, x, gate=None):\n    a = x.sin()\n    b = a.cos()\n    c = b.tanh()\n    d = c.relu()\n    if foreign_check(gate):\n        d = d * gate\n    e = d.sin()\n    f = e.cos()\n    g = f.tanh()\n    return g.relu()"
        }
      ],
