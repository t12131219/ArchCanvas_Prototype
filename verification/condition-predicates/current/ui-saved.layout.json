            "column": 4,
            "end_column": 23,
            "symbol": "ConditionalSplice.forward",
            "expression": "def forward(self, x, gate=None, other=None):\n    a = x.sin()\n    b = a.cos()\n    c = b.tanh()\n    d = c.relu()\n    if gate is not None:\n        d = d * gate\n    e = d.sin()\n    f = e.cos()\n    if other is not None:\n        f = f + other\n    g = f.tanh()\n    return g.relu()"
          }
        ],
