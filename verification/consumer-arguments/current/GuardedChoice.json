      "id": "model/46:4:composite:1/47:8:composite:1/36:4:composite:1",
      "kind": "composite",
      "label": "self.weave",
      "parent": "model/46:4:composite:1/47:8:composite:1",
      "source_parent": "model/46:4:composite:1/47:8:composite:1",
      "source": [
        {
          "file": "/home/fzg/PycharmProjects/ArchCanvas/prototype/Summary_Merge/tests/semantic_fixtures/consumer_arguments.py",
          "line": 36,
          "end_line": 44,
          "column": 4,
          "end_column": 16,
          "symbol": "weave",
          "expression": "def weave(self, x, *, selected=False):\n    a = x.sin()\n    b = x.cos()\n    c = x.tanh()\n    y = a + b + c\n    y = y.relu().sin().cos().tanh()\n    if selected:\n        return (y, a)\n    return y"
        }
      ],
      "evidence_status": "static-only",
