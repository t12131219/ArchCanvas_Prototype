          "end_column": 40,
          "symbol": "ChosenCircuit.forward",
          "expression": "def forward(self, x, side, flag):\n    weights, indices = torch.topk(torch.softmax(x, dim=-1), 1, dim=-1)\n    if flag:\n        result = self.a(side)\n    else:\n        result = self.b(side)\n    return (result * weights, indices)"
        }
      ],
