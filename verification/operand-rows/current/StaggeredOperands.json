          "symbol": "StaggeredOperands.forward",
          "expression": "def forward(self, left, middle, right):\n    a = torch.sin(left)\n    b = torch.tanh(torch.cos(middle))\n    c = torch.relu(right)\n    return torch.cat((a, b, c), dim=-1)"
        }
      ],
