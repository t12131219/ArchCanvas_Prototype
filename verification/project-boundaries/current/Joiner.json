          "symbol": "Joiner.forward",
          "expression": "def forward(self, tensor_list: NestedTensor):\n    xs = self[0](tensor_list)\n    out: List[NestedTensor] = []\n    pos = []\n    for name, x in xs.items():\n        out.append(x)\n        pos.append(self[1](x).to(x.dtype))\n    return (out, pos)"
        }
