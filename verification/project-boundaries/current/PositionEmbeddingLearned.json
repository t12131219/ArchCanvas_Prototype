          "column": 4,
          "end_column": 18,
          "symbol": "PositionEmbeddingLearned.forward",
          "expression": "def forward(self, tensor_list: NestedTensor):\n    x = tensor_list.tensors\n    h, w = x.shape[-2:]\n    i = torch.arange(w, device=x.device)\n    j = torch.arange(h, device=x.device)\n    x_emb = self.col_embed(i)\n    y_emb = self.row_embed(j)\n    pos = torch.cat([x_emb.unsqueeze(0).repeat(h, 1, 1), y_emb.unsqueeze(1).repeat(1, w, 1)], dim=-1).permute(2, 0, 1).u"
        }
      ],
