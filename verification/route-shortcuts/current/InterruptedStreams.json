          "symbol": "InterruptedStreams.forward",
          "expression": "def forward(self, x: Tensor, state: Tensor, flag):\n    local = self.patch(x)\n    foreign = unfamiliar(local, state)\n    if flag:\n        return foreign + local\n    return foreign * state"
        }
