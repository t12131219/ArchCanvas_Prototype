          "column": 4,
          "end_column": 23,
          "symbol": "MultilayerPerceptron.forward",
          "expression": "def forward(self, x):\n    z_1 = torch.mm(x, self.weight_1.t()) + self.bias_1\n    a_1 = torch.sigmoid(z_1)\n    z_2 = torch.mm(a_1, self.weight_o.t()) + self.bias_o\n    a_2 = torch.sigmoid(z_2)\n    return (a_1, a_2)"
        }
      ],
