          "file": "/home/fzg/PycharmProjects/ArchCanvas/Source_Code_Project/deeplearning-models-master/deeplearning-models-master/pytorch_ipynb/cnn/nin-cifar10_filter-response-norm.ipynb#cell=4",
          "line": 23,
          "end_line": 32,
          "column": 4,
          "end_column": 60,
          "symbol": "FilterResponseNormalization.forward",
          "expression": "def forward(self, x):\n    n, c, h, w = x.size()\n    self.eps = self.eps.to(self.tau.device)\n    nu2 = torch.mean(x.pow(2), (2, 3), keepdims=True)\n    x = x * torch.rsqrt(nu2 + torch.abs(self.eps))\n    return torch.max(self.gamma * x + self.beta, self.tau)"
        }
      ],
