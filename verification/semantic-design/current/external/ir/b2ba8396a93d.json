        {
          "file": "/home/fzg/PycharmProjects/ArchCanvas/Source_Code_Project/deeplearning-models-master/deeplearning-models-master/pytorch_ipynb/mechanics/cnn-weight-sharing.ipynb#cell=12",
          "line": 49,
          "end_line": 69,
          "column": 4,
          "end_column": 29,
          "symbol": "ConvNet.forward",
          "expression": "def forward(self, x):\n    out = self.conv_1(x)\n    out = F.relu(out)\n    out = self.pool_1(out)\n    out = self.conv_2(out)\n    out = F.relu(out)\n    out = self.pool_2(out)\n    logits = self.linear_1(out.view(-1, 7 * 7 * 8))\n    logits = logits + self.linear_1_bias\n    probas = F.softmax(logits, dim=1)\n    return (logits, probas)"
        }
      ],
