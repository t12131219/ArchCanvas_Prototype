          "end_column": 50,
          "symbol": "RNN.forward",
          "expression": "def forward(self, text, text_length):\n    embedded = self.embedding(text)\n    packed = torch.nn.utils.rnn.pack_padded_sequence(embedded, text_length)\n    packed_output, hidden = self.rnn(packed)\n    return self.fc(hidden.squeeze(0)).view(-1)"
        }
