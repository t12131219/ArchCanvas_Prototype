          "expression": "def curve(x):\n    x = torch.sin(x)\n    x = torch.sin(x)\n    x = torch.sin(x)\n    x = torch.sin(x)\n    x = torch.sin(x)\n    x = torch.sin(x)\n    x = torch.sin(x)\n    x = torch.sin(x)\n    x = torch.tanh(x)\n    x = torch.tanh(x)\n    x = torch.tanh(x)\n    x = torch.nan_to_num(x, nan=0.0)\n    x = torch.nan_to_num(x, nan=1.0)\n    return torch.cos(x)"
