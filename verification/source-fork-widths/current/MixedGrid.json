          "symbol": "MixedGrid.forward",
          "expression": "def forward(self, value: Tensor, state: Tensor, flag):\n    known = self.patch(value)\n    unknown = unfamiliar(known, state)\n    if flag:\n        return unknown + known\n    return unknown * state"
        }
